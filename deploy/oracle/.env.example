# Copie para ".env" nesta pasta (deploy/oracle/) e preencha. Nunca faça commit do .env.
#   cp .env.example .env && nano .env

# Domínio público da API (DuckDNS grátis: https://www.duckdns.org)
DOMAIN=seunome.duckdns.org

# Gere cada segredo com:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# O app (Expo) e o painel web chamam a API por este endereço
CORS_ALLOW_ORIGINS=https://seunome.duckdns.org

ACCESS_TOKEN_EXPIRE_MINUTES=10080
PUSH_ENABLED=true

# Opcional: relatório de erros (sentry.io). Vazio = desligado.
SENTRY_DSN=

# Opcional: login com GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://seunome.duckdns.org/api/v1/auth/github/callback
