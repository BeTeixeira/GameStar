{
  "expo": {
    "name": "GameStar",
    "slug": "gamestar-app",
    "scheme": "gamestar",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O GameStar acessa suas fotos para você escolher a foto e o fundo do perfil.",
          "cameraPermission": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0a3ba86f-9501-45b3-ba96-063fabde7419"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.gamestar.frontapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://crispness-doily-brilliant.ngrok-free.dev",
      "router": {},
      "eas": {
        "projectId": "0a3ba86f-9501-45b3-ba96-063fabde7419"
      }
    },
    "owner": "cdobruski"
  }
}
