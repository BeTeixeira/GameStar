APP_NAME=recommendation-service
PORT=8001

# URL base da API principal. Com o gateway no ar, aponte para ele
# (ex.: http://localhost:8080/api/v1) e o gateway resolve a instância pelo Eureka.
GAMESTAR_API_URL=http://localhost:8000/api/v1
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=10

WEIGHT_GENRE=0.4
WEIGHT_FRIENDS=0.4
WEIGHT_GLOBAL=0.2
RANKING_MIN_VOTES=3

EUREKA_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost
