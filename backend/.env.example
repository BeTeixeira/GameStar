# Copie este arquivo para ".env" (mesma pasta) antes de rodar a API.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Mac/Linux:             cp .env.example .env
#
# Os valores abaixo já funcionam "out of the box" para rodar localmente
# em modo demonstração — sem Docker, sem Azure e sem nenhum banco externo.

# ── Aplicação ────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=demo-secret-key-troque-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origens permitidas por CORS, separadas por vírgula (sem espaços extras).
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Banco de dados ───────────────────────────────────────
# Local / demonstração (SQLite — arquivo "gamestar.db" criado automaticamente,
# nenhuma instalação ou conexão externa necessária):
DATABASE_URL=sqlite+aiosqlite:///./gamestar.db

# Servidor de produção: gamestartidea3.database.windows.net (banco: gamestart)
# Produção (Azure SQL) — mantido aqui apenas como referência para deploy futuro,
# não é necessário para rodar a demonstração local:
# DATABASE_URL=mssql+aioodbc://usuario:senha@servidor.database.windows.net:1433/gamestar?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# ── GitHub OAuth (opcional) ──────────────────────────────
# Só é necessário se for testar o login real via GitHub.
# Crie um OAuth App em https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── Push (Expo) ──────────────────────────────────────────
PUSH_ENABLED=true
